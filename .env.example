# Backend variables belong in backend/.env (copy backend/.env.example)
APP_NAME=Industrial Asset Lifecycle Management and Tracking System
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=replace_with_a_long_random_secret

DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/asset_tracking_db
DB_HOST=localhost
DB_PORT=3306
DB_USER=DB_USER
DB_PASSWORD=DB_PASSWORD
DB_NAME=asset_tracking_db

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend variable belongs in frontend/.env (copy frontend/.env.example)
VITE_API_URL=http://127.0.0.1:8000/api/v1
